# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# env
.env

# private, never upload
_donotdeploy/

# images downloaded from Gemini, waiting for npm run images:import
gemini-obrazky/stazene/*
!gemini-obrazky/stazene/.gitkeep
assets/exercises/_inbox/
# originals moved here by npm run images:import
gemini-obrazky/hotove/

# Gemini kit for the painted game: downloads, originals and previews stay local
gemini-obrazky/hra/stazene/*
!gemini-obrazky/hra/stazene/.gitkeep
gemini-obrazky/hra/hotove/
gemini-obrazky/hra/nahled-*.png
# the full-size city painting the style reference is made from (7.8 MB)
gemini-obrazky/Assets/

# Originals of the dressing-up layers (13 MB): scripts/dress-layers.mjs cuts dress/*.webp from them;
# the cut pictures are in git, the originals stay on the machine that imported them.
assets/game/painted/dressup/layer-*.jpg
